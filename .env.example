# =============================================================================
# .env.example - Contoh Konfigurasi Lingkungan (Environment Variables)
# =============================================================================
# Salin file ini menjadi .env dan sesuaikan nilainya:
# cp .env.example .env (Linux/Mac) atau copy .env.example .env (Windows)

# Konfigurasi Aplikasi
APP_NAME="Web Portfolio"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/web-portfolio

# Konfigurasi Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=data_portfolio
DB_USER=root
DB_PASSWORD=

# Konfigurasi SMTP Mail (Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_digit_app_password
MAIL_RECEIVER=receiver_email@gmail.com
MAIL_RECEIVER_NAME="Heru Perdana Saputra"
